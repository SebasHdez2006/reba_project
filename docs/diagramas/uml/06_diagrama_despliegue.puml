@startuml 06_diagrama_despliegue
title REBA — Diagrama de despliegue (hardware + software)

left to right direction
skinparam nodeStyle rectangle

' ================== DISPOSITIVO EDGE ==================
node "ESP32-CAM AI-Thinker\n«hardware + firmware»" as esp {
  artifact "fotos_nc.ino → firmware\n«binario flasheado/OTA, sin endpoints»" as fwBin
  artifact "NVS (Preferences)\n«wifi_ssid, wifi_pass, server_url(+_alt),\nsrv_act, pump_photos, pump_seconds,\ndist_min/max, ota_last»" as nvsCfg
  component "HC-SR04\n«TRIG=GPIO14 · ECHO=GPIO15÷1k/2k»" as hc
  component "OV2640 + flash GPIO4" as ov
  component "Relé GPIO13 (activo-bajo, NC)\n→ bomba 12V" as relay
  component "WiFi 2.4 GHz\n«cliente STA»" as wifi
  fwBin --> hc
  fwBin --> ov
  fwBin --> relay
  fwBin --> wifi
  fwBin --> nvsCfg
}

' ================== ENERGÍA ==================
node "Cadena de potencia\n«independiente del software»" as pwr {
  component "Panel solar 5V → TP4056" as solar
  component "18650 3.7V 2800mAh" as bat
  component "XL6009 boost → 12.0V" as boost
  component "Fuente 5V dedicada" as p5v
  solar --> bat : carga
  bat --> boost : sw ON
  boost --> relay : +12V → COM→NC→bomba
  p5v --> fwBin : 5V/GND (nunca desde boost)
}

' ================== RED ==================
cloud "Red Wi-Fi 2.4 GHz LAN\n«REBA-AP hotspot o router local\n(sin Internet en campo)»" as lan

cloud "Cloudflare edge\n«túnel nombrado rebaserver.tech»" as cfEdge {
  artifact "http://rebaserver.tech :80\n«ESP32 — HTTP plano»" as cfHttp
  artifact "https://rebaserver.tech :443\n«dashboard remoto TLS»" as cfHttps
}

' ================== PC ==================
node "PC — servidor + dashboard" as pc {
  node "SO Windows" {
    artifact "uvicorn server.main:app\n«proceso Python :5000»" as uvicorn
    artifact "cloudflared.exe\n«túnel → localhost:5000,\nautostart Startup/*.vbs»" as cfDaemon
    artifact "server/*.py + .venv\n«fastapi, onnxruntime, opencv, numpy,\npydantic-settings, sqlite3»" as pyDeps
    artifact "models/best.onnx\n«YOLOv8n v5 época 30»" as onnxFile
    artifact "data/REBA.db\n«SQLite WAL — 5 tablas»" as sqliteFile
    artifact "static/\n«index.html app.js styles.css\nsimulador_esp32.html fonts/»" as staticDir
    artifact "firmware/fotos_nc.bin\n«OTA — GET /firmware.bin»" as fwBinArt
    uvicorn --> pyDeps
    uvicorn --> onnxFile
    uvicorn --> sqliteFile
    uvicorn --> staticDir
    uvicorn --> fwBinArt
    cfDaemon --> uvicorn : proxy :5000
  }
  artifact ".env\n«HOST, PORT, MODEL_PATH,\nINFERENCE_*, CLASS_NAMES,\nCAPTURE_RETENTION»" as dotenv
  artifact "tools/cloudflared_config.yml\n«tunnel id + ingress»" as cfCfg
  cfDaemon --> cfCfg
}

' ================== CLIENTES ==================
node "Navegador — dashboard" as clients {
  node "Celular en REBA-AP" as phone {
    artifact "http://192.168.137.1:5000\n«HTML/JS servido por la PC»" as phoneUI
  }
  node "Navegador en la PC" as pcBrowser {
    artifact "http://localhost:5000" as pcUI
  }
  node "Celular/PC remoto\n«cualquier red con Internet»" as remote {
    artifact "https://rebaserver.tech\n«mismo dashboard por el túnel»" as remoteUI
  }
}

' ================== COMUNICACIONES ==================
esp --> lan : "WiFi STA\nHTTP POST /upload (JPEG)\nGET /api/device/config c/60s\nPOST /api/device/ack + /status"
esp ..> cfHttp : "«alt: server_url_alt»\nmismo tráfico HTTP por el túnel"
lan --> pc : "TCP :5000\nHTTP + WebSocket /ws"
cfEdge --> pc : "cloudflared http2\n→ localhost:5000"
pc --> lan : "sirve static/ + REST + WS"
lan --> phone : "HTTP :5000"
lan --> pcBrowser : "HTTP :5000"
cfHttps --> remote : "HTTPS dashboard"

note bottom of lan
  Camino primario LAN — el sistema opera SIN Internet.
  El túnel Cloudflare es el acceso remoto opcional: el ESP32
  conmuta solo a server_url_alt tras 3 polls fallidos
  (re-sondeo de la principal cada 5 min).
  Firewall Windows debe permitir TCP 5000 entrante.
  Respaldo dashboard: zrok https://reba-cam.shares.zrok.io.
end note

note bottom of esp
  La ESP32 no expone endpoints: solo cliente.
  Bomba/trigger autónomos aunque la PC esté apagada
  (cola RAM ≤6 fotos, reintento 15 s, descarte anti poison-pill).
end note

note bottom of pwr
  Regla crítica: ESP32 siempre a 5V dedicada;
  bomba a 12V vía relé NC. Bomba ON si ESP32 pierde energía
  (fail-open documentado; mitigado por batería compartida).
end note

@enduml
