# =============================================================================
# REBA — Variables de entorno del servidor PC
# Copia este archivo a `.env` y ajusta los valores.
# Documentación completa: docs/server.md
#
# NOTA: la IP y el puerto deben coincidir con server_url del ESP32. Desde el
# firmware v2 (Preferences + config remota) el ESP32 puede cambiar su
# server_url SIN reflashear: dashboard → Dispositivo, portal REBA-Setup o
# comandos serie (SET server_url=...). Aun así, si cambias PORT aquí, el
# ESP32 debe recibir la nueva URL por una de esas vías.
# =============================================================================

# --- Servidor HTTP ---
# HOST=0.0.0.0 acepta conexiones de cualquier equipo de la LAN.
# PORT debe coincidir con el puerto de SERVIDOR_URL en el ESP32.
HOST=0.0.0.0
PORT=5000

# --- Modelo de visión artificial ---
# Modelo YOLOv8 entrenado localmente y exportado a ONNX
MODEL_PATH=models/best.onnx
# Confianza mínima para aceptar una detección ONNX (0.0–1.0)
# 0.35 es el punto de máximo F1 medido con tune_confidence.py sobre el
# conjunto difícil REBA_outdoor_eval con el modelo outdoor v2
# (P=0.79 / R=0.77 / F1=0.78). La curva es plana: 0.30–0.45 dan F1 similar.
INFERENCE_CONFIDENCE=0.35
# IoU NMS
INFERENCE_IOU=0.45

# --- Clases del modelo (orden = class_id YOLO 0..N-1) ---
CLASS_NAMES=plastico,unicel,metal

# --- Bomba (INFORMATIVO: espejar constantes del firmware) ---
# El conteo real ocurre en la ESP32; el servidor solo lo infiere por uploads.
# Deben coincidir con FOTOS_PARA_BOMBA y TIEMPO_BOMBA_MS de fotos_nc.ino.
PUMP_TRIGGER_PHOTOS=3
PUMP_RUN_SECONDS=10

# --- Rango ultrasónico del firmware (cm, informativo para el dashboard) ---
# Deben coincidir con DIST_MIN_CM / DIST_MAX_CM de fotos_nc.ino.
DETECT_MIN_CM=0
DETECT_MAX_CM=23

# --- Base de datos SQLite ---
DATABASE_PATH=data/REBA.db
# Máximo de capturas JPEG conservadas (0 = sin límite). Poda horaria de las
# más viejas; las detecciones y eventos sobreviven. ~5 KB por captura.
CAPTURE_RETENTION=2000

# --- Clasificador híbrido (opcional; vacío = solo detector) ---
# Un solo ONNX o lista por comas = ensemble: las probs de cada modelo se
# alinean por nombre de clase y se concatenan; CLS_META_PATH (npz W/b) las
# combina con la regresión logística entrenada por
# ai_pipeline/export_cls_ensemble.py (sin meta = media de probs).
# Ensemble v1+DINO+11s medido: acc 0.858 agua / 0.901 tierra
# (datasets/REBA_cls_esp32) con CLS_CONFIDENCE=0.3.
CLS_MODEL_PATH=models/cls_esp32.onnx,models/cls_dino.onnx,models/cls_11s.onnx,models/cls_dinob_feat.onnx
CLS_META_PATH=models/cls_meta_feat.npz
# Probabilidad mínima del top-1 para aceptar la clase (si no -> fondo).
CLS_CONFIDENCE=0.3

# --- Túnel zrok (opcional: solo para acceso remoto del dashboard/celular) ---
# URL pública fija y gratuita (https://<nombre>.shares.zrok.io) sin comprar dominio.
# La reserva se crea UNA vez con setup_zrok.bat, que rellena
# ZROK_RESERVED_NAME automáticamente. Vacío = share efímero (URL nueva
# en cada arranque del túnel, como el antiguo quick tunnel de Cloudflare).
#ZROK_RESERVED_NAME=reba-cam
# Objetivo local del túnel (el servidor FastAPI).
ZROK_TARGET_URL=http://127.0.0.1:5000
